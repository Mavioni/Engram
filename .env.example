# Engram frontend environment — COMMITTED AS TEMPLATE (placeholder values only)
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Backend API base URL
VITE_API_URL=http://localhost:8787

# Application version (injected at build time)
VITE_APP_VERSION=0.1.0

# Apple Sign-In client ID (public — safe to commit when real value is known)
VITE_APPLE_CLIENT_ID=

# Google OAuth client ID (public — safe to commit when real value is known)
VITE_GOOGLE_CLIENT_ID=

# RevenueCat public SDK keys (platform-specific, NOT secret)
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
